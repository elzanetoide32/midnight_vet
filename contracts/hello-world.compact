pragma language_version >= 0.22;

import CompactStandardLibrary;

export enum Species {
  dog,
  cat,
  bird,
  rabbit,
  other
}

export struct Pet {
  owner: Opaque<"string">;
  name: Opaque<"string">;
  species: Species;
  breed: Opaque<"string">;
  birthYear: Opaque<"string">;
}

export struct VisitRecord {
  doctor: Opaque<"string">;
  note: Opaque<"string">;
}

export ledger pets: Map<Opaque<"string">, Pet>;
export ledger visitCount: Map<Opaque<"string">, Counter>;
export ledger lastVisit: Map<Opaque<"string">, VisitRecord>;

export circuit registerPet(
  petId: Opaque<"string">,
  owner: Opaque<"string">,
  name: Opaque<"string">,
  species: Species,
  breed: Opaque<"string">,
  birthYear: Opaque<"string">
): [] {
  assert(!pets.member(disclose(petId)), "Esta mascota ya esta registrada");

  pets.insert(disclose(petId), Pet {
    owner: disclose(owner),
    name: disclose(name),
    species: disclose(species),
    breed: disclose(breed),
    birthYear: disclose(birthYear)
  });

  visitCount.insertDefault(disclose(petId));
}

export circuit addVisit(
  petId: Opaque<"string">,
  doctorAddress: Opaque<"string">,
  note: Opaque<"string">
): [] {
  assert(pets.member(disclose(petId)), "La mascota no esta registrada");

  visitCount.lookup(disclose(petId)).increment(1);

  lastVisit.insert(disclose(petId), VisitRecord {
    doctor: disclose(doctorAddress),
    note: disclose(note)
  });
}